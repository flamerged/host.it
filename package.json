{
  "name": "hostit-app",
  "packageManager": "yarn@4.6.0",
  "devDependencies": {
    "@prettier/plugin-ruby": "4.0.4",
    "bootstrap": "4.5.3",
    "concurrently": "9.1.2",
    "prettier": "3.5.2"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.7.2",
    "@hotwired/turbo-rails": "8.0.12",
    "@rails/actioncable": "8.0.100",
    "@rails/activestorage": "8.0.100",
    "flatpickr": "4.6.6",
    "mapbox-gl": "1.13.0",
    "sass": "1.85.0"
  },
  "scripts": {
    "build:css": "sass ./app/assets/stylesheets/application.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules",
    "watch:css": "sass --watch ./app/assets/stylesheets/application.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules",
    "rails": "bin/rails server",
    "dev": "concurrently \"yarn watch:css\" \"yarn rails\""
  }
}
