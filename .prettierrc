{
  "semi": false,
  "trailingComma": "none",
  "singleQuote": true,
  "printWidth": 120,
  "plugins": ["@prettier/plugin-ruby"],
  "overrides": [
    {
      "files": "*.yml",
      "options": {
        "tabWidth": 2,
        "useTabs": false,
        "parser": "yaml"
      }
    },
    {
      "files": "*.json",
      "options": {
        "printWidth": 80,
        "trailingComma": "all"
      }
    }
  ]
}
